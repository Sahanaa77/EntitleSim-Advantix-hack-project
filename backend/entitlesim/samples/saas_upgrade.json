  "invariants": [
    { "id": "INV-1", "type": "feature_access_matches_plan" },
    { "id": "INV-2", "type": "usage_within_quota" },
    { "id": "INV-3", "type": "tenant_isolation" },
    { "id": "INV-4", "type": "no_access_after_cancel" },
    { "id": "INV-5", "type": "cache_db_consistent" }
